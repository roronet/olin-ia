PORT=3001
NODE_ENV=development
# URL(s) del frontend, separadas por coma (CORS y enlaces de verificación)
FRONTEND_URL=http://localhost:5173

# SMTP (Gmail: activar verificación en 2 pasos y crear una "contraseña de aplicación")
# Si se deja vacío, el enlace de verificación se imprime en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OLIN IA <tu-correo@gmail.com>"
